<% content_for :hide_header, true %>
<% content_for(:title, "「こえ」を録音する｜こえだより") %>

<div class="flex min-h-screen w-full flex-col items-center px-4">
  <h1 class="mb-6 mt-8 text-center text-2xl font-bold text-primary sm:text-3xl">「こえ」を録音する</h1>

  <div class="card w-full max-w-lg rounded-2xl border border-base-300 bg-white p-5 text-center shadow-sm sm:p-8">
    <div data-controller="recording" data-recording-slug-value="<%= params[:slug] %>">
      <div class="mb-6 hidden text-center text-xl font-bold" data-recording-target="errorSection" role="alert">
        <p>うまく届きませんでした。<br>ご家族に相談するか、もう一度録音してください。</p>
        <button data-recording-target="retryBtn" data-action="click->recording#retry" class="btn btn-error mt-4">もう一度こえを録音する</button>
      </div>

      <div class="mb-6 hidden text-center text-xl font-bold" data-recording-target="micErrorSection" role="alert">
        マイクを使用できません。画面右上の「…」から「他のブラウザで開く」を選んでください。
      </div>

      <div class="mb-8">
        <p class="mb-1 text-base font-bold text-base-content">話す内容</p>
        <p class="text-center text-3xl font-bold"><%= @theme.title %></p>
      </div>

      <div data-recording-target="recordSection" class="text-center">
        <button data-recording-target="toggleBtn" data-action="click->recording#toggle" class="recording-button h-56 w-56 rounded-full focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-primary sm:h-64 sm:w-64" aria-label="こえの録音を始める" aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="mx-auto mb-2 size-14 text-white" aria-hidden="true">
            <path d="M8.25 4.5a3.75 3.75 0 1 1 7.5 0v8.25a3.75 3.75 0 1 1-7.5 0V4.5Z"/>
            <path d="M6 10.5a.75.75 0 0 1 .75.75v1.5a5.25 5.25 0 1 0 10.5 0v-1.5a.75.75 0 0 1 1.5 0v1.5a6.751 6.751 0 0 1-6 6.709v2.291h3a.75.75 0 0 1 0 1.5h-7.5a.75.75 0 0 1 0-1.5h3v-2.291a6.751 6.751 0 0 1-6-6.709v-1.5A.75.75 0 0 1 6 10.5Z"/>
          </svg>
          <span data-recording-target="buttonLabel" class="text-xl font-bold text-white">ここを押して<br>「こえ」を録音する</span>
        </button>
        <p data-recording-target="status" class="mt-8 text-base font-bold text-error" aria-live="polite">押すと録音が始まります</p>
        <div data-recording-target="timer" class="mt-3 min-h-5 text-center text-xs font-normal tabular-nums text-base-content/50" aria-live="off"></div>
      </div>

      <div data-recording-target="completeSection" class="hidden">
        <div class="relative mx-auto size-56 sm:size-64">
          <svg class="size-56 -rotate-90 sm:size-64" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="45" fill="none" stroke="#e5e7eb" stroke-width="8" />
            <circle cx="50" cy="50" r="45" fill="none" stroke-width="8" stroke-dasharray="283" stroke-dashoffset="283" class="animate-draw-circle text-success" stroke="currentColor" />
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="absolute inset-0 m-auto h-24 w-24 text-success">
            <path d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.74a.75.75 0 0 1 1.04-.207Z"/>
          </svg>
        </div>
        <p class="mt-6 text-center text-xl">「こえ」を届けました</p>
        <%= link_to "続けて「こえ」を録音する", speaker_path(params[:slug]), class: "btn recording-again-button mx-auto mt-6 flex h-auto py-3 text-lg focus-visible:outline-4 focus-visible:outline-offset-4 focus-visible:outline-primary" %>
      </div>
    </div>
  </div>
</div>
