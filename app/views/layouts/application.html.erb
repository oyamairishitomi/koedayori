<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "こえだより｜「こえ」でつながる、やさしい安心。" %></title>
    <meta name="description" content="離れて暮らすご家族の声を録音して届ける、シンプルな声のメッセージサービス。かんたん録音・スマホだけで完結。">
    <meta name="keywords" content="こえだより,見守り,実家,離れて暮らす家族,声のメッセージ,高齢者,安否確認">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Koedayori">
    <meta name="mobile-web-app-capable" content="yes">

    <meta property="og:title" content="こえだより｜「こえ」でつながる、やさしい安心。">
    <meta property="og:description" content="離れて暮らすご家族の声を録音して届ける、シンプルな声のメッセージサービス。かんたん録音・スマホだけで完結。">
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://koe.life">
    <meta property="og:image" content="<%= image_url("koedayori_sns.png") %>">
    <meta property="og:site_name" content="こえだより">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="こえだより｜「こえ」でつながる、やさしい安心。">
    <meta name="twitter:description" content="離れて暮らすご家族の声を録音して届ける、シンプルな声のメッセージサービス。かんたん録音・スマホだけで完結。">
    <meta name="twitter:image" content="<%= image_url("koedayori_sns.png") %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="<%= asset_path("favicon.png") %>" type="image/png">
    <link rel="apple-touch-icon" href="<%= asset_path("favicon.png") %>">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="min-h-screen flex flex-col">
  <% unless content_for?(:hide_header) %>
    <%if current_family %>
    <div class="navbar bg-primary px-4 shadow-sm sm:px-2">
      <div class="container mx-auto flex px-0 sm:px-5">
        <div class="navbar-start">
          <%= link_to families_speakers_path do %>
            <%= image_tag "koedayori_brand_white.webp", alt: "こえだより", class: "h-5 w-auto sm:h-8" %>
          <% end %>
        </div>
        <div class="navbar-end gap-4">
          <div class="hidden sm:flex items-center gap-4">
            <%= link_to "今日の「こえ」", families_speakers_path, class: "whitespace-nowrap text-s text-neutral-content" %>
            <%= link_to "設定", families_settings_path, class: "whitespace-nowrap text-s text-neutral-content" %>
            <%= current_family ? link_to("ログアウト", families_session_path(current_family), data: { turbo_method: :delete }, class: "whitespace-nowrap text-sm text-primary-content/80 underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-4") : link_to("ログイン", new_families_session_path, class: "btn btn-neutral") %>
          </div>

          <details class="dropdown dropdown-end translate-x-4 sm:hidden">
            <summary class="btn btn-ghost list-none text-white" aria-label="メニューを開く">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="size-7" aria-hidden="true">
                <path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </summary>
            <nav class="dropdown-content z-10 mt-2 flex w-52 flex-col rounded-box bg-base-100 p-2 text-primary shadow-sm" aria-label="スマホ用メニュー">
              <%= link_to "今日の「こえ」", families_speakers_path, class: "rounded-lg px-4 py-2 hover:bg-base-200" %>
              <%= link_to "設定", families_settings_path, class: "rounded-lg px-4 py-2 hover:bg-base-200" %>
              <%= link_to "ログアウト", families_session_path(current_family), data: { turbo_method: :delete }, class: "mt-2 border-t border-base-300 px-4 pb-2 pt-3 text-sm opacity-70 hover:bg-base-200" %>
            </nav>
          </details>
        </div>
      </div>
    </div>
    <% else %>
    <div class="navbar bg-primary px-4 shadow-sm sm:px-2">
      <div class="container mx-auto flex px-0 sm:px-5">
        <div class="navbar-start">
          <%= link_to root_path do %>
            <%= image_tag "koedayori_brand_white.webp", alt: "こえだより", class: "h-5 w-auto sm:h-8" %>
          <% end %>
        </div>
        <div class="navbar-end gap-4">
          <div class="flex items-center gap-4">
            <%= link_to("新規登録", new_families_registration_path, class: "btn btn-primary") %>
            <%= link_to("ログイン", new_families_session_path, class: "btn btn-primary-content") %>
          </div>
        </div>
      </div>
    </div>
    <% end %>
    <% end %>
    <main class="<%= content_for?(:hide_header) ? "flex w-full flex-1" : "container mx-auto mt-8 flex flex-1 px-5" %>">
      <%= yield %>
    </main>
  
  <footer class="container mx-auto mt-auto rounded-t-2xl bg-base-200 px-5 py-6 text-base-content">
    <div class="flex flex-col items-center gap-3 text-center sm:flex-row sm:justify-center sm:gap-5">
      <p class="text-sm opacity-70">© 2026 こえだより</p>
      <nav class="flex flex-wrap justify-center gap-x-4 gap-y-2" aria-label="フッターナビゲーション">
        <%= link_to "プライバシーポリシー", privacy_path, class: "text-sm opacity-70" %>
        <%= link_to "利用規約", terms_path, class: "text-sm opacity-70" %>
      </nav>
    </div>
  </footer>

  </body>
</html>
