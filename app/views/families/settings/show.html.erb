<% content_for(:title, "こえだよりの設定｜こえだより") %>
<div class="w-full max-w-2xl mx-auto">
  <%= render "shared/success_messages", messages: [flash[:notice]].compact %>
  <%= render "shared/error_messages", messages: current_family.errors.full_messages %>
    <%= render "shared/page_title", text: "こえだよりの設定" %>
    <%= form_with url: families_settings_path, method: :patch do |form| %>
    <% speaker = current_family.speakers.first %>

<fieldset class="fieldset bg-base-100 border border-base-300 rounded-box p-4">
  <legend class="fieldset-legend">こえが届いていないときのお知らせ</legend>
  <ul class="list bg-base-100 rounded-box">
    <li class="list-row items-center">
      <div class="min-w-0">こえが何時までに届かなければ画面上で知らせるか</div>
      <div class="justify-self-end"><%= form.select :notify_at, (0..23).map { |h| format("%02d:00", h) } ,{selected: speaker&.notify_at&.strftime("%H:%M") }, {class: "select sm:ml-auto w-24"} %></div>
    </li>
  </ul>
</fieldset>

<fieldset class="fieldset bg-base-100 border border-base-300 rounded-box p-4">
  <legend class="fieldset-legend">こえを届ける家族</legend>
    <ul class="list bg-base-100 rounded-box">
      <% current_family.speakers.order(active: :desc).each do |speaker| %>
      <li class="list-row items-center">
        <div><%= speaker.name %></div>
        <div class="justify-self-end"><%= link_to "こえの録音の準備", families_speaker_path(speaker), class: "btn btn-outline btn-sm" %></div>
      </li>
      <% end %>
    </ul>
</fieldset>

<fieldset class="fieldset bg-base-100 border border-base-300 rounded-box p-4">
  <legend class="fieldset-legend">見守る家族</legend>
  <ul class="list bg-base-100 rounded-box">
    <li class="list-row items-center">
      <div>あいことばの変更</div>
      <div class="justify-self-end"><%= form.text_field :aikotoba, class: "input" %></div>
    </li>
    <li class="list-row items-center">
      <div>メールアドレスの変更</div>
      <div class="justify-self-end"><%= form.text_field :email, class: "input" %></div>
    </li>
  </ul>
</fieldset>

  <%= form.submit "設定を更新する", class: "btn btn-primary mt-4" %>
  <div class="divider"></div>

<fieldset class="fieldset bg-base-200 border border-base-300 rounded-box p-4">
  <legend class="fieldset-legend">停止設定</legend>
  <ul class="list bg-base-200 rounded-box" >
    <% current_family.speakers.order(active: :desc).each do |speaker| %>
    <li class="list-row items-center">
      <div><%= speaker.name %></div>
      <div class="justify-self-end"><%= link_to "受け取りを停止する", deactivate_families_speaker_path(speaker), class: "btn btn-outline btn-error btn-sm", data: { turbo_method: :patch, turbo_confirm: "本当に停止してよろしいですか？二度と戻せません。" }  %></div>
    </li>
    <% end %>
  </ul>
</fieldset>

  <% end %>
  <div class="divider"></div>
  <%= link_to "退会する", new_families_withdrawal_path, class: "btn btn-outline btn-error btn-sm" %>
  <%= link_to families_speakers_path, class: "btn btn-ghost mt-4" do %>
    <%= icon("chevron-right", css_class: "w-4 h-4 rotate-180") %>
    今日のこえに戻る
  <% end %>
</div>
