<% content_for(:title, "設定｜こえだより") %>

<div class="mx-auto w-full max-w-2xl">
  <%= render "shared/success_messages", messages: [flash[:notice]].compact %>
  <%= render "shared/error_messages", messages: current_family.errors.full_messages %>
  <%= render "shared/page_title", text: "設定" %>

  <%= form_with url: families_settings_path, method: :patch, class: "space-y-6" do |form| %>
    <% speaker = current_family.speakers.first %>

    <fieldset class="min-w-0 overflow-hidden rounded-xl border border-base-300 bg-base-100">
      <legend class="sr-only">「こえ」が届いていないときのお知らせ</legend>
      <div class="border-b border-base-300 bg-base-200/50 px-5 py-4">
        <h2 class="text-lg font-bold">「こえ」が届いていないときのお知らせ</h2>
      </div>
      <div class="p-5">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <%= form.label :notify_at, "今日の「こえ」が届いていないことを知らせる時刻", class: "font-bold text-base-content" %>
            <p class="mt-1 text-sm text-base-content/70">この時刻を過ぎても録音がない場合、今日の「こえ」に表示します。</p>
          </div>
          <%= form.select :notify_at, (0..23).map { |h| format("%02d:00", h) }, { selected: speaker&.notify_at&.strftime("%H:%M") }, { class: "select w-28 shrink-0" } %>
        </div>
      </div>
    </fieldset>

    <fieldset class="min-w-0 overflow-hidden rounded-xl border border-base-300 bg-base-100">
      <legend class="sr-only">「こえ」を届ける家族</legend>
      <div class="border-b border-base-300 bg-base-200/50 px-5 py-4">
        <h2 class="text-lg font-bold">「こえ」を届ける家族</h2>
      </div>
      <div class="p-5">
        <ul class="divide-y divide-base-300">
          <% current_family.speakers.each do |registered_speaker| %>
            <li class="flex flex-col gap-3 py-4 first:pt-1 last:pb-1 sm:flex-row sm:items-center sm:justify-between">
              <span class="font-bold"><%= registered_speaker.name %></span>
              <%= link_to "録音の準備方法を確認", families_speaker_path(registered_speaker), class: "btn btn-outline btn-sm" %>
            </li>
          <% end %>
        </ul>
      </div>
    </fieldset>

    <fieldset class="min-w-0 overflow-hidden rounded-xl border border-base-300 bg-base-100">
      <legend class="sr-only">見守る家族のログイン情報</legend>
      <div class="border-b border-base-300 bg-base-200/50 px-5 py-4">
        <h2 class="text-lg font-bold">見守る家族のログイン情報</h2>
      </div>
      <div class="p-5">
        <div class="space-y-5">
          <div>
            <%= form.label :aikotoba, "「あいことば」の変更", class: "label mb-2 font-bold text-base-content" %>
            <%= form.text_field :aikotoba, value: current_family.aikotoba, class: "input w-full" %>
          </div>
          <div>
            <%= form.label :email, "メールアドレスの変更", class: "label mb-2 font-bold text-base-content" %>
            <%= form.email_field :email, value: current_family.email, class: "input w-full" %>
          </div>
        </div>
      </div>
    </fieldset>

    <%= form.submit "設定を更新する", class: "btn btn-primary min-h-12" %>
  <% end %>

  <section class="mt-10 rounded-xl border border-error/30 bg-error/5 p-5" aria-labelledby="danger-zone-title">
    <h2 id="danger-zone-title" class="mb-4 text-lg font-bold text-error">利用の停止・退会</h2>
    <ul class="divide-y divide-error/20">
      <% current_family.speakers.each do |registered_speaker| %>
        <li class="flex flex-col gap-3 py-4 first:pt-0 sm:flex-row sm:items-center sm:justify-between">
          <span><%= registered_speaker.name %>さんのこえの受け取り</span>
          <%= link_to "受け取りを停止する", deactivate_families_speaker_path(registered_speaker), class: "btn btn-outline btn-error btn-sm", data: { turbo_method: :patch, turbo_confirm: "#{registered_speaker.name}さんのこえの受け取りを停止します。停止後は再開できません。よろしいですか？" } %>
        </li>
      <% end %>
    </ul>
    <div class="mt-4 border-t border-error/20 pt-4">
      <%= link_to "退会する", new_families_withdrawal_path, class: "btn btn-outline btn-error btn-sm" %>
    </div>
  </section>

  <%= link_to families_speakers_path, class: "link link-primary mx-auto mt-8 flex w-fit items-center gap-1 font-bold" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 19.5-7.5-7.5 7.5-7.5" />
    </svg>
    今日の「こえ」に戻る
  <% end %>
</div>
