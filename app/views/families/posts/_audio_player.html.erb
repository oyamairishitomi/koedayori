<div class="flex w-full items-center gap-3 rounded-xl bg-base-200 p-3" data-controller="playback">
  <button type="button" data-playback-target="playButton" data-action="click->playback#togglePlay" class="btn btn-circle btn-primary h-12 w-12 shrink-0" aria-label="再生">
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
      <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd"/>
    </svg>
  </button>

  <div class="min-w-0 flex-1">
    <label class="sr-only" for="post-<%= post.id %>-seek">再生位置</label>
    <input id="post-<%= post.id %>-seek" type="range" min="0" max="100" value="0" step="0.1" data-playback-target="seekInput" data-action="input->playback#seek" class="range range-primary range-sm w-full" aria-label="再生位置">
    <div class="mt-1 flex justify-between text-xs tabular-nums text-base-content/60">
      <span data-playback-target="currentTime">0:00</span>
      <span data-playback-target="duration">0:00</span>
    </div>
  </div>

  <%= audio_tag(post.audio, hidden: true, preload: "metadata", data: { playback_target: "audio", action: "loadedmetadata->playback#showDuration timeupdate->playback#updateProgress ended->playback#resetButton" }) %>
</div>
