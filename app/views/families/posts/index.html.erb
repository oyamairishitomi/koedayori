<% content_for(:title, "#{@speaker.name}さんのこえ｜こえだより") %>

<div class="mx-auto w-full max-w-3xl">
  <%= render "shared/page_title", text: "#{@speaker.name}さんのこえ" %>

  <% if @posts.any? %>
    <ul class="space-y-4">
      <% @posts.each do |post| %>
        <li class="card border border-base-300 bg-white p-4 shadow-sm sm:p-5">
          <div class="mb-4">
            <p class="font-bold"><%= post.theme&.title.presence || "テーマなし" %></p>
            <time datetime="<%= post.created_at.iso8601 %>" class="mt-1 block text-sm text-base-content/60"><%= post.created_at.strftime("%Y年%-m月%-d日 %H:%M") %></time>
          </div>

          <%= render "families/posts/audio_player", post: post %>
        </li>
      <% end %>
    </ul>

    <div class="mt-6"><%= paginate @posts %></div>
  <% else %>
    <div class="rounded-xl border border-base-300 bg-white p-6 text-center">
      <p class="mb-4">まだ今日の「こえ」が録音されていません。</p>
      <%= link_to families_speaker_path(@speaker), class: "btn btn-outline btn-primary btn-sm h-auto w-full py-2 text-base leading-relaxed" do %>
        <span>録音の準備方法を<br>開始する</span>
      <% end %>
    </div>
  <% end %>

  <%= link_to families_speakers_path, class: "link link-primary mx-auto mt-8 flex w-fit items-center gap-1 font-bold" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 19.5-7.5-7.5 7.5-7.5" />
    </svg>
    今日の「こえ」に戻る
  <% end %>
</div>
