<% content_for(:title, "#{@speaker.name}さんの録音準備｜こえだより") %>
<div class="mx-auto w-full max-w-2xl">
  <%= render "shared/page_title", text: "#{@speaker.name}さんの録音準備" %>
  <p class="mb-6 leading-relaxed"><%= @speaker.name %>さんがスマートフォンで毎日の「こえ」を録音できるよう、準備を進めます。</p>

  <ol class="space-y-4">
    <li class="rounded-2xl border border-base-300 bg-white p-5 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">1</span>
        <h2 class="text-2xl font-bold">録音ページを開く</h2>
      </div>
      <p class="mt-5 leading-relaxed"><%= @speaker.name %>さんのスマートフォンで、下のQRコードを読み取って録音ページを開きます。</p>

      <div class="mt-5 flex justify-center">
        <%= speaker_qrcode %>
      </div>
      <p class="mt-5 font-bold leading-relaxed">QRコードを読み取れない場合は、LINEまたはURLで<%= @speaker.name %>さんへ録音ページを共有してください。</p>
      <div class="mx-auto mt-4 grid w-full max-w-sm grid-cols-1 gap-2 sm:grid-cols-2">
        <%= link_to "LINEで送る", "https://line.me/R/msg/text/?#{ERB::Util.url_encode("こえだよりの録音ページはこちら\n#{speaker_share_url(@speaker)}")}", target: "_blank", rel: "noopener", class: "btn btn-outline btn-primary w-full" %>
        <button type="button" data-controller="clipboard" data-clipboard-url-value="<%= speaker_share_url(@speaker) %>" data-action="click->clipboard#copy" class="btn btn-outline btn-primary w-full">URLをコピー</button>
      </div>
    </li>

    <li class="rounded-2xl border border-base-300 bg-white p-5 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">2</span>
        <h2 class="text-2xl font-bold">録音ページをホーム画面に追加</h2>
      </div>
      <p class="mt-5 leading-relaxed">毎日の録音で迷わないよう、録音ページをホーム画面に追加します。</p>
      <section class="mt-6 overflow-hidden rounded-xl border border-base-300 bg-[#f8f9f7]" aria-labelledby="home-screen-instructions-title">
        <h3 id="home-screen-instructions-title" class="border-b border-base-300 bg-base-200 px-4 py-3 text-lg font-bold sm:px-6">ホーム画面への追加方法</h3>
        <div class="p-4 sm:p-6">
          <p class="leading-relaxed"><%= @speaker.name %>さんのスマートフォンに合わせて、iPhoneまたはAndroidを選んでください。</p>

          <div class="mt-5 space-y-6 sm:hidden">
            <section aria-labelledby="iphone-instructions-title">
              <h4 id="iphone-instructions-title" class="mb-3 font-bold text-primary">iPhoneの場合（Safari）</h4>
              <%= render "iphone_home_screen_steps" %>
            </section>
            <section class="border-t border-base-300 pt-6" aria-labelledby="android-instructions-title">
              <h4 id="android-instructions-title" class="mb-3 font-bold text-primary">Androidの場合（Chrome）</h4>
              <%= render "android_home_screen_steps" %>
            </section>
          </div>

          <div class="tabs mt-4 hidden gap-2 [--tab-height:2.25rem] sm:flex">
            <input type="radio" name="home_screen_tabs" class="tab flex-1 rounded-full border border-primary bg-white px-5 text-primary transition checked:bg-primary checked:text-primary-content" aria-label="iPhoneの場合(Safari)" checked="checked" />
            <div class="tab-content pt-5">
              <%= render "iphone_home_screen_steps" %>
            </div>

            <input type="radio" name="home_screen_tabs" class="tab flex-1 rounded-full border border-primary bg-white px-5 text-primary transition checked:bg-primary checked:text-primary-content" aria-label="Androidの場合(Chrome)" />
            <div class="tab-content pt-5">
              <%= render "android_home_screen_steps" %>
            </div>
          </div>
        </div>
      </section>
    </li>

    <li class="rounded-2xl border border-base-300 bg-white p-5 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">3</span>
        <h2 class="text-2xl font-bold">マイクの使用を許可</h2>
      </div>
      <p class="mt-5 leading-relaxed">録音ページで「ここを押して こえを録音する」を押します。確認画面が表示されたら、マイクの使用を許可してください。</p>
    </li>

    <li class="rounded-2xl border border-base-300 bg-white p-5 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">4</span>
        <h2 class="text-2xl font-bold">「こえ」を録音</h2>
      </div>
      <p class="mt-5 leading-relaxed"><%= @speaker.name %>さんのスマートフォンで、ホーム画面に追加した「こえだより」を開き、画面の案内に沿って「こえ」を録音します。</p>
    </li>

    <li class="rounded-2xl border border-base-300 bg-white p-5 shadow-sm sm:p-8">
      <div class="flex items-start gap-3">
        <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-primary font-bold text-primary-content">5</span>
        <h2 class="text-2xl font-bold">「こえ」が届いていることを確認</h2>
      </div>
      <p class="mt-5 leading-relaxed"><%= link_to "今日の「こえ」ページ", families_speakers_path, class: "link link-primary font-bold" %>を開き、録音した「こえ」が届いていることを確認します。</p>
    </li>
  </ol>

  <%= link_to families_speakers_path, class: "link link-primary mx-auto mt-6 flex w-fit items-center gap-1 font-bold" do %>
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="size-4" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" d="m15.75 19.5-7.5-7.5 7.5-7.5" />
    </svg>
    今日の「こえ」に戻る
  <% end %>
</div>
