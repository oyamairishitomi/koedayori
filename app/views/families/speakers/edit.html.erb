<%# これは使用しない可能性が高い

<% content_for(:title, "#{@speaker.name}さんの設定｜こえだより") %>
<div>
    使用しない可能性が高い
    <%= render "shared/page_title", text: "#{@speaker.name}さんの設定" %>
    <%= form_with model: @speaker, url: families_speaker_path(@speaker) do |form| %>

    <div class="divider"></div>
    <ul class="list bg-base-100 rounded-box shadow-md mb-4">
    <li class="list-row flex-col flex sm:flex-row">
        <div>
        <div>登録情報（表示名）</div>
        <div class="text-xs opacity-60">こちらでご家族のお名前を確認・変更できます。</div>
        </div>
        <%= form.text_field :name, class: "input sm:ml-auto"%>
    </li>
    </ul>

    <div class="divider"></div>
    <ul class="list bg-base-100 rounded-box shadow-md mb-4">
    <li class="list-row sm:items-center flex-col flex sm:flex-row">
        <div>
        <div>セットアップ画面</div>
        <div class="text-xs opacity-60">こちらでご家族の吹き込み画面のURLを確認できます。<br>
        <p><%= speaker_share_url(@speaker) %></p></div>
        </div>
        <%= link_to "セットアップ画面", families_speaker_path(@speaker), class: "sm:ml-auto" %>
    </li>
    </ul>

    <ul class="list bg-base-100 rounded-box shadow-md mb-4">
    <li class="list-row sm:items-center flex-col flex sm:flex-row">
        <div>
        <div><%= form.label :notifications_enabled %></div>
        <div class="text-xs opacity-60">ダッシュボードで未着通知をするか指定できます。指定しないことも可能です。</div>
        </div>
        <%= form.checkbox :notifications_enabled, class: "toggle sm:ml-auto" %>
    </li>
    </ul>

    <ul class="list bg-base-100 rounded-box shadow-md mb-4">
    <li class="list-row flex-col flex sm:flex-row">
        <div>
        <div><%= form.label :notify_at %></div>
        <div class="text-xs opacity-60">何時までに吹き込みをするかの通知時刻を指定してください。指定しないことも可能です。</div>
        </div>
        <%= form.select :notify_at, (0..23).map { |h| "#{h}:00" } ,{selected: "#{@speaker.notify_at.hour}:00"}, {class: "select sm:ml-auto"} %>
    </li>
    </ul>

    <ul class="list bg-base-100 rounded-box shadow-md mb-4">
    <li class="list-row bg-base-200 flex-col flex sm:flex-row">
        <div>
        <div>こえの受け取りを終了する</div>
        <div class="text-xs opacity-60">一度受け取りを終了した場合、再開することはできません。これまでのこえは再生できます。</div>
        </div>
        <%= link_to "こえの受け取りを終了する", deactivate_families_speaker_path(@speaker), class: "btn btn-error sm:ml-auto", data: { turbo_method: :patch, turbo_confirm: "本当に停止してよろしいですか？" } %>
    </li>
    </ul>

    <%= form.submit "設定を更新する", class: "btn btn-primary" %>
    <% end %>
</div> %>