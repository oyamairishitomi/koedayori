<% content_for(:title, "今日のこえ｜こえだより") %>
<div class="w-full">
  <%= render "shared/success_messages", messages: [flash[:notice]].compact , class: "mb-4" %>
  <%= render "shared/page_title", text: "今日のこえ" %>
  <%= Time.zone.now.strftime("%Y/%m/%d %H:%M") %>
  <div class="divider"></div>
  <% unless current_family.speakers.empty? %>

  <details class="collapse collapse-arrow bg-base-100 border border-base-300 mt-4 mb-4" open data-controller="dismissible" data-dismissible-target="details">
    <summary class="collapse-title">はじめに、２つの役割を知ってください。</summary>
    <div class="collapse-content">
      <div class="flex flex-col items-center gap-2 py-2 text-center">
        <div class="flex flex-col items-center gap-1">
          <h2 class="text-lg font-bold mb-3">こえだより の しくみ</h2>
          <div class="bg-primary/10 rounded-full p-3 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-primary">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
            </svg>
          </div>
          <span class="badge badge-primary badge-lg my-2">こえを届ける人</span>
          <p class="text-xs text-base-content/70">例）おじいちゃん・おばあちゃん</p>
        </div>

        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-base-content/50">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
        <p class="text-sm font-medium">毎日、専用ページからこえを吹き込む</p>

        <div class="bg-primary rounded-full px-4 py-2">
          <%= image_tag "koedayori_logo_white.png", alt: "こえだより", class: "h-6" %>
        </div>

        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-5 h-5 text-base-content/50">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
        <p class="text-sm font-medium">こえが届く</p>

        <div class="flex flex-col items-center gap-1">
          <div class="bg-warning/10 rounded-full p-3 mb-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-warning">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19.114 5.636a9 9 0 0 1 0 12.728M16.463 8.288a5.25 5.25 0 0 1 0 7.424M6.75 8.25l4.72-4.72a.75.75 0 0 1 1.28.53v15.88a.75.75 0 0 1-1.28.53l-4.72-4.72H4.5a.75.75 0 0 1-.75-.75v-6a.75.75 0 0 1 .75-.75h2.25Z" />
            </svg>
          </div>
          <span class="badge badge-warning badge-lg my-2">こえを聞く人</span>
          <p class="text-xs text-base-content/70">例）お子さん・お孫さん</p>

          <div role="alert" class="alert alert-info mt-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-6 w-6 shrink-0 stroke-current">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>家族の誰かが声を聞くと、「安否確認」ができたことになります</span>
          </div>
        </div>
        <button data-dismissible-target="button" data-action="click->dismissible#click" class="btn btn-soft mt-4 mb-4" >今後表示しない</button>
      </div>
    </div>
  </details>
  <% end %>

  <div class="mb-4">
    <%= current_family.speakers.empty? ? "まずは以下のボタンより、こえを届ける人を登録してください。": ""%>
  </div>
  <%= link_to "こえを届ける人を追加する", new_families_speaker_path, class: "btn btn-primary text-lg mb-6" %>
  <ul class="flex flex-col md:flex-row gap-4 flex-wrap items-stretch">
    <% current_family.speakers.order(active: :desc).each do |speaker| %>
      <% border_color = if !speaker.notifications_enabled
            "border-l-base-300"
          else
            case speaker.status
            when :needs_read then "border-l-warning"
            when :needs_attention then "border-l-error"
            when :confirmed then "border-l-success"
            when :inactive then "border-l-base-300"
            when :waiting then "border-l-primary"
            end
          end %>
      <li class="card bg-base-100 border-l-4 <%= border_color %> border-base-300 shadow-sm w-full md:w-80 transition hover:shadow-lg hover:scale-105 <%= "opacity-50" unless speaker.active? %>">
        <%= link_to families_speaker_posts_path(speaker), class: "card-body" do %>
          <div class="flex items-center gap-3">
            <div class="bg-base-200 rounded-full p-2">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-base-content">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
              </svg>
            </div>
            <div>
              <h2 class="card-title"><%= speaker.name %></h2>
              <h3 class="text-primary text-xs">こえを届ける人</h3>
            </div>
          </div>

            <% if speaker.status == :needs_read && speaker.notifications_enabled %>
              <div role="alert" class="alert bg-base-200 text-base-content">
                <span><%= speaker.posts.order(created_at: :desc).first&.theme&.title %>に答えました</span>
              </div>
              <p class="flex items-center gap-1 text-xs">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                今日 <%= speaker.posts.order(created_at: :desc).first&.created_at&.strftime("%H:%M") %> に届きました
              </p>
              <div role="alert" class="alert alert-warning alert-soft">
                <span>今日まだ誰も聞いていません</span>
              </div>
            <% end %>

            <% if speaker.status == :needs_attention && speaker.notifications_enabled %>
              <div role="alert" class="alert alert-error alert-soft">
                <span>今日はまだ届いていません</span>
              </div>
            <% end %>

            <% if speaker.status == :confirmed && speaker.notifications_enabled %>
              <div role="alert" class="alert bg-base-200 text-base-content">
                <span><%= speaker.posts.order(created_at: :desc).first&.theme&.title %>に答えました</span>
              </div>
              <p class="flex items-center gap-1 text-xs">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-4 h-4">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                今日 <%= speaker.posts.order(created_at: :desc).first&.created_at&.strftime("%H:%M") %> に届きました
              </p>
              <div role="alert" class="alert alert-success alert-soft">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4">
                  <path fill-rule="evenodd" d="M19.916 4.626a.75.75 0 0 1 .208 1.04l-9 13.5a.75.75 0 0 1-1.154.114l-6-6a.75.75 0 0 1 1.06-1.06l5.353 5.353 8.493-12.739a.75.75 0 0 1 1.04-.208Z" clip-rule="evenodd" />
                </svg>
                <span>誰かが聞きました</span>
              </div>
            <% end %>

            <% if speaker.status == :waiting && speaker.notifications_enabled %>
            <% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
